# Staging Environment Configuration
# Use this in staging/pre-production deployments

# API Configuration
VITE_API_BASE_URL=https://staging-api.example.com
VITE_API_TIMEOUT=30000

# Environment
VITE_ENV=staging
NODE_ENV=production

# Logging
VITE_LOG_LEVEL=info
VITE_LOG_TO_SERVER=true

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_ERROR_OVERLAY=true
VITE_ENABLE_ANALYTICS=true

# WebSocket Configuration
VITE_WEBSOCKET_URL=wss://staging-api.example.com
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=5
VITE_WEBSOCKET_RECONNECT_DELAY=3000

# Security
VITE_SECURE_COOKIES=true
VITE_CORS_ENABLED=true

# Performance
VITE_ENABLE_COMPRESSION=true
VITE_CACHE_DURATION=1800

# Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/staging-project-id
VITE_ENABLE_PERFORMANCE_MONITORING=true
