# Development Environment Configuration
# Use this in local development

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=10000

# Environment
VITE_ENV=development
NODE_ENV=development

# Logging
VITE_LOG_LEVEL=debug
VITE_LOG_TO_SERVER=false

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_ERROR_OVERLAY=true
VITE_ENABLE_ANALYTICS=false

# WebSocket Configuration
VITE_WEBSOCKET_URL=ws://localhost:8000
VITE_WEBSOCKET_RECONNECT_ATTEMPTS=3
VITE_WEBSOCKET_RECONNECT_DELAY=1000

# Security
VITE_SECURE_COOKIES=false
VITE_CORS_ENABLED=true

# Performance
VITE_ENABLE_COMPRESSION=false
VITE_CACHE_DURATION=0

# Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false
